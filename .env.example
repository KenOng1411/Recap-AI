# Copy this file to .env.local and fill in real values.
# Because this site is statically exported (`output: "export"`), NEXT_PUBLIC_*
# variables are baked into the build at `npm run build` time — set this before
# building, not just before deploying.

# Email shown on the site (About, Partner With Us, Disclosure pages, mailto links).
NEXT_PUBLIC_CONTACT_EMAIL=contact@yourdomain.com
